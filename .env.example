# Every setting, for every environment. Copy to .env for `pnpm dev`, or to
# .env.production for Docker Compose, and fill in what you need.
#
# NUXT_* settings are read by the app. The rest, at the bottom, are read by
# Docker Compose only. "Required in production" means the app can't run
# without it: `make check ENV=production` lists any that are missing.

# --- Development only -------------------------------------------------------

# Where `pnpm dev` keeps its data: json (a dev data file, seeded with test
# people, the default) or mysql (NUXT_DATABASE_URL). Ignored in production.
# NUXT_DATA_STORE=json

# How `pnpm dev` signs people in: sandbox (pick any test person, no Google
# account needed) or provider (real Google). Unset picks sandbox unless
# NUXT_OIDC_CLIENT_ID is set. Ignored in production.
# NUXT_SIGN_IN=sandbox

# A second database for `pnpm test`, wiped by the tests. Never the real one.
# Tests that need a database skip without it.
NUXT_TEST_DATABASE_URL=mysql://application:CHANGE_ME@localhost:3306/eagata_test

# --- Build ------------------------------------------------------------------

# true includes the platform admin area, at /platform. Read when the app is
# built, not when it runs: false leaves it out of the build entirely.
NUXT_PLATFORM=false

# --- Database ---------------------------------------------------------------

# Required in production. The app's connection to MariaDB or MySQL, as a user
# that may read and write data but not change tables. Inside Docker Compose the
# host is `mariadb`, not localhost, and `make app-user` creates this user, with
# this password, after `make migrate`.
NUXT_DATABASE_URL=mysql://application:CHANGE_ME@localhost:3306/eagata

# --- Sessions ---------------------------------------------------------------

# Required in production. Encrypts the sign-in cookie, so anyone with it can
# forge a session: keep it secret. At least 32 characters, such as
# `openssl rand -base64 48`. Changing it signs everyone out. Dev uses a fixed
# value when empty.
NUXT_SESSION_SECRET=

# --- Sign-in with Google ----------------------------------------------------

# Required in production. From the Google Cloud Console's OAuth client.
NUXT_OIDC_CLIENT_ID=
NUXT_OIDC_CLIENT_SECRET=

# Where Google sends people back after sign-in. Empty uses
# /api/auth/callback on whatever address the request came to. Set it when the
# app sits behind a proxy that changes the address. Register the same URL
# with Google either way.
# NUXT_OIDC_REDIRECT_URI=https://app.example.com/api/auth/callback

# Only for a sign-in provider other than Google. The provider name is stored
# with each linked account, so don't change it once people have signed in.
# It also names the sign-in button: "janus" gets Janus's name and logo, and
# any other name a plain key. For Janus, the issuer ends in the tenant's slug.
# NUXT_PUBLIC_SIGN_IN_PROVIDER=janus
# NUXT_OIDC_ISSUER=https://auth.example.com/system
# NUXT_OIDC_ISSUER_ALIASES=

# The sign-in button's label. Empty names the provider: "Continue with Janus".
# NUXT_PUBLIC_SIGN_IN_LABEL=

# --- Public address ---------------------------------------------------------

# Required in production. The address people use, such as
# https://app.example.com. Links in emails, like password resets, point here.
NUXT_APP_URL=

# true when a proxy sits in front of the app. The app then takes the client's
# address from the proxy's X-Forwarded-For header, so limits such as "20
# sign-in attempts per address" count each visitor, not the proxy.
NUXT_TRUST_PROXY=false

# --- Email ------------------------------------------------------------------

# Mail through AWS SES, such as password resets and invites. Required in
# production. In dev, an empty sender prints mail to the log instead.
NUXT_EMAIL_SES_SENDER=
NUXT_EMAIL_SES_REGION=eu-west-1
# An AWS key allowed ses:SendEmail. Empty uses the machine's own AWS
# credentials, such as an instance role.
NUXT_EMAIL_ACCESS_KEY_ID=
NUXT_EMAIL_SECRET_ACCESS_KEY=

# --- Uploaded images --------------------------------------------------------

# Where the app saves uploaded images, relative to where it starts. Docker
# Compose sets its own, inside the container: see MEDIA_DIR below.
NUXT_MEDIA_DIR=./instance/media

# --- Docker Compose only ----------------------------------------------------
# The app never sees these. MARIADB_PASSWORD is required; the rest have the
# default shown. Make every password with
# `openssl rand -hex 24`: hex needs no escaping in a URL.

# The migrator: the user MariaDB creates on its first start, with every
# privilege on the database. Migrations and `make admin` connect as it. Read
# once, when MariaDB's data folder is empty: changing them later changes
# nothing in the database. Root gets a random password, printed once to
# MariaDB's log, and nothing uses it.
# MARIADB_DATABASE=eagata
# MARIADB_USER=eagata_migrator
# MARIADB_PASSWORD=
# The same user and password, as a URL. Unset, migrations use
# NUXT_DATABASE_URL, which works only while that user may change tables, before
# `make app-user` limits it.
# MIGRATION_DATABASE_URL=mysql://eagata_migrator:<hex>@mariadb:3306/eagata

# Folders on this machine for MariaDB's data and the uploaded images. The
# media folder must be writable by uid 1000, the app container's user.
# MARIADB_DATA_DIR=./instance/mariadb
# MEDIA_DIR=./instance/media

# The images to run. Each slot runs its own, so a release goes to the idle
# slot while the other keeps serving.
# BLUE_IMAGE=eagata-app:latest
# GREEN_IMAGE=eagata-app:latest
# EAGATA_TOOLS_IMAGE=eagata-tools:latest

# Where each slot and MariaDB listen on this machine. 127.0.0.1 is reachable
# from this machine only. For a proxy on another machine, use this machine's
# network address, such as 192.168.1.150:3000, and firewall it to the proxy.
# BLUE_BIND=127.0.0.1:3000
# GREEN_BIND=127.0.0.1:3001
# MARIADB_BIND=127.0.0.1:3306
