# Every real setting. Copy to .env and fill in what you need. Unset values
# use the defaults in packages/nuxt-shell/nuxt.config.ts.

# MariaDB or MySQL. Without it, the app has no data store.
NUXT_DATABASE_URL=mysql://application:CHANGE_ME@localhost:3306/eagata

# A separate database for `pnpm test`. Tests that need it skip without it.
NUXT_TEST_DATABASE_URL=mysql://application:CHANGE_ME@localhost:3306/eagata_test

# Seals the session cookie. At least 32 characters, e.g. `openssl rand -base64 48`.
# Dev falls back to a fixed secret when empty. Production refuses to start without it.
NUXT_SESSION_SECRET=

# Sign-in, with any OIDC provider. These defaults are Google's.
# The provider name is stored with each linked account, so keep it stable.
NUXT_OIDC_PROVIDER=google
NUXT_OIDC_ISSUER=https://accounts.google.com
# Comma-separated other spellings of the issuer in ID tokens.
NUXT_OIDC_ISSUER_ALIASES=accounts.google.com
NUXT_OIDC_CLIENT_ID=
NUXT_OIDC_CLIENT_SECRET=
# Must match the redirect URI registered with the provider.
NUXT_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
