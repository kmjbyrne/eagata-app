{
  "name": "@kmjbyrne/nuxt-shell",
  "version": "0.0.0",
  "description": "Nuxt layer for every app on the foundation: sign-in, sessions, orgs, workspaces and the service container",
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./types": "./types.ts",
    "./mysql": "./server/adapters/mysql/index.ts",
    "./adapters": "./server/adapters/index.ts",
    "./testing": "./testing/index.ts",
    "./contracts": "./shared/contracts/index.ts"
  },
  "files": [
    "nuxt.config.ts",
    "types.ts",
    "app",
    "server",
    "shared",
    "testing",
    "!**/*.test.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "db:test-generate": "drizzle-kit generate --config drizzle.test.config.ts"
  },
  "dependencies": {
    "@kmjbyrne/core": "workspace:*",
    "@kmjbyrne/oidc": "workspace:*"
  },
  "peerDependencies": {
    "@nuxt/test-utils": "^4.3.3",
    "@nuxt/ui": "^4.11.0",
    "drizzle-orm": "catalog:",
    "h3": "catalog:",
    "mysql2": "catalog:",
    "nuxt": "^4.5.0",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "@nuxt/test-utils": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.3",
    "@nuxt/ui": "^4.11.3",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "h3": "catalog:",
    "mysql2": "catalog:",
    "zod": "catalog:"
  }
}
