{
  "name": "eagata-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "platform:grant": "tsx --env-file-if-exists=.env scripts/platform-grant.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.139",
    "@iconify-json/simple-icons": "^1.2.98",
    "@kmjbyrne/nuxt-shell": "workspace:*",
    "@nuxt/ui": "^4.11.3",
    "drizzle-orm": "catalog:",
    "mysql2": "catalog:",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@kmjbyrne/core": "workspace:*",
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^24.19.1",
    "drizzle-kit": "catalog:",
    "eslint": "^10.12.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "packageManager": "pnpm@12.9.1",
  "volta": {
    "node": "24.21.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "overrides": [
      {
        "files": "*.md",
        "options": {
          "printWidth": 80,
          "proseWrap": "always"
        }
      }
    ]
  }
}
