# Runs the app with no services: data comes from a JSON file seeded from
# fixtures, and sign-in goes through the sandbox's stand-in for the provider.
# scripts/ensure-env copies this to .env when there is none.

# json (the sandbox's dev data) or mysql (NUXT_DATABASE_URL)
NUXT_DATA_STORE=json

# true builds in the platform admin area, at /platform. Read at build time.
NUXT_PLATFORM=true
